# Configuration for Zotero Local API
ZOTERO_API_URL=http://localhost:23119/api
ZOTERO_USER_ID=0
# Local write API key (automatically populated by running `zotero-cleaner auth`)
ZOTERO_API_KEY=
# Request timeout in seconds
ZOTERO_TIMEOUT=30

# PDF Importer configuration
# Default folder containing PDF files to scan and import
PDF_IMPORT_DIR=/home/goulu/moulinette/Documents/Articles
# Import mode: 'imported' (copies PDF into Zotero storage) or 'linked' (links to existing path)
PDF_IMPORT_MODE=imported
# Zotero local storage directory (used when mode is 'imported')
ZOTERO_STORAGE_DIR=/home/goulu/Zotero/storage
